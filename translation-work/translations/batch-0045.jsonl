{"EN": "A-ah...", "PTBR": "A-ah...", "fallback": false, "file": "Widget/Nenene/default.txt", "gender": {"addressee": "unknown", "referent": "unknown", "speaker": "unknown"}, "id": "Widget/Nenene/default.txt::L46", "kind": "txt_line", "line": 46, "source_file": "Widget/Nenene/default.txt", "tokens": []}
